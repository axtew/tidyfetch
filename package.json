{
  "name": "tidyfetch",
  "version": "0.0.0",
  "description": "A small HTTP client on fetch: typed errors, timeouts, one shared token refresh for parallel 401s, optional schema validation.",
  "keywords": [
    "fetch",
    "http",
    "http-client",
    "typescript",
    "refresh-token",
    "abort",
    "timeout",
    "standard-schema"
  ],
  "license": "MIT",
  "author": "Artur Ovcharenko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axtew/tidyfetch.git"
  },
  "homepage": "https://github.com/axtew/tidyfetch#readme",
  "bugs": "https://github.com/axtew/tidyfetch/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.build.json --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:package": "publint && attw --pack . --profile esm-only",
    "lint:fix": "oxlint --type-aware --fix",
    "typecheck:compat": "pnpm --package=typescript@5.0 dlx tsc -p tsconfig.compat.json",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:package"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "prettier": "^3.10.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "typescript": "~7.0.2",
    "unrun": "^0.3.1",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.6.2",
  "engines": {
    "node": ">=20.3"
  }
}
